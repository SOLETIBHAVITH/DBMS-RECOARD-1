CREATE TABLE e10e_students (
    id NUMBER PRIMARY KEY,
    name VARCHAR2(30),
    marks NUMBER
);

INSERT INTO e10e_students VALUES (1, 'Ravi', 70);
INSERT INTO e10e_students VALUES (2, 'Priya', 85);
INSERT INTO e10e_students VALUES (3, 'Arun', 65);

-- Implicit Cursor

BEGIN
    UPDATE e10e_students
    SET marks = marks + 5
    WHERE marks < 80;

    DBMS_OUTPUT.PUT_LINE(
        'Rows Updated: ' || SQL%ROWCOUNT
    );
END;
/

-- Explicit Cursor

DECLARE
    CURSOR c_student IS
        SELECT name, marks
        FROM e10e_students
        ORDER BY id;
BEGIN
    FOR s IN c_student LOOP
        DBMS_OUTPUT.PUT_LINE(
            s.name || ' - ' || s.marks
        );
    END LOOP;
END;
/
Output:
Rows Updated: 2

Ravi - 75
Priya - 85
Arun - 70

PL/SQL procedure successfully completed.
